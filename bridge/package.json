{
  "name": "@angatusistemas/whatsapp-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Bridge Node.js que expoe o Baileys para o Angatu WhatsApp SDK (Java) via WebSocket local. Nao e publicado no npm; e compilado e embutido como recurso dentro do JAR do SDK.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "dev": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "baileys": "6.7.24",
    "pino": "9.6.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "overrides": {
    "libsignal": "npm:libsignal@6.0.0"
  }
}
