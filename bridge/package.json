{
  "name": "@angatusistemas/whatsapp-bridge",
  "version": "2.0.0",
  "private": true,
  "description": "Node.js bridge that exposes Baileys to the Angatu WhatsApp SDK (Java) over a local WebSocket. Not published to npm: bundled and shipped inside the SDK jar.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "dev": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "pino": "9.6.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
