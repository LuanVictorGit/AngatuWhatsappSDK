<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.angatusistemas</groupId>
        <artifactId>angatu-whatsapp-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>angatu-whatsapp</artifactId>
    <packaging>jar</packaging>

    <name>Angatu WhatsApp SDK</name>
    <description>
        API Java para WhatsApp. Gerencia o runtime Node.js, o processo bridge com o Baileys e a
        comunicacao WebSocket local; a fila de interacoes fica em SQLite pela AngatuLibraries.
    </description>

    <properties>
        <bridge.dir>${project.basedir}/../bridge</bridge.dir>
    </properties>

    <dependencies>
        <!-- Persistence (Saveable), JSON (GsonAPI) and logging (Console). -->
        <dependency>
            <groupId>com.github.LuanVictorGit</groupId>
            <artifactId>AngatuLibraries</artifactId>
        </dependency>
        <!-- The persistence row of AngatuLibraries: its dependencies are optional, so they are declared here. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- QR code PNG rendering, no external service. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!--
            Blocking-socket WebSocket client. The JDK's java.net.http.WebSocket opens an NIO Selector,
            whose loopback wake-up pipe fails in some restricted Windows environments; this client
            carries every byte between Java and the bridge, so that risk is not taken.
        -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <angatu.db>${project.build.directory}/test-database.db</angatu.db>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Automatic-Module-Name>com.angatusistemas.whatsapp</Automatic-Module-Name>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Rebuilds the Node bridge (npm install + esbuild) into src/main/resources/bridge/ whenever npm
            is on the build machine. The bundle is also committed, so a build without Node (JitPack,
            -Dskip.bridge.build) packages the committed one. Consumers never need Node at build time.
            Two profiles because Windows resolves npm as npm.cmd, which a JVM process launch does not.
        -->
        <profile>
            <id>build-bridge-windows</id>
            <activation>
                <os><family>windows</family></os>
                <property><name>!skip.bridge.build</name></property>
            </activation>
            <properties>
                <npm.executable>npm.cmd</npm.executable>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>npm-install</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${npm.executable}</executable>
                                    <workingDirectory>${bridge.dir}</workingDirectory>
                                    <arguments>
                                        <argument>install</argument>
                                        <argument>--no-audit</argument>
                                        <argument>--no-fund</argument>
                                        <argument>--prefer-offline</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${npm.executable}</executable>
                                    <workingDirectory>${bridge.dir}</workingDirectory>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-bridge-unix</id>
            <activation>
                <os><family>unix</family></os>
                <property><name>!skip.bridge.build</name></property>
            </activation>
            <properties>
                <npm.executable>npm</npm.executable>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>npm-install</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${npm.executable}</executable>
                                    <workingDirectory>${bridge.dir}</workingDirectory>
                                    <arguments>
                                        <argument>install</argument>
                                        <argument>--no-audit</argument>
                                        <argument>--no-fund</argument>
                                        <argument>--prefer-offline</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${npm.executable}</executable>
                                    <workingDirectory>${bridge.dir}</workingDirectory>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
